{
  "name": "shiptest",
  "version": "0.1.0",
  "description": "Local-first enterprise AI benchmarking framework for evaluating model performance on private repositories.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "shiptest": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-report-assets.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "husky",
    "precommit": "lint-staged && npm run typecheck && npm run test:run",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [
    "ai",
    "benchmark",
    "evaluation",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.5"
  },
  "private": true,
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.72.1",
    "commander": "^14.0.3",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.4",
    "zod": "^4.4.2"
  }
}
